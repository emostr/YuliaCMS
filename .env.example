# --- Yulia CMS ---------------------------------------------------------------
# Copy this file to .env and fill it in. InstallYulia.rb does that for you.

# The admin panel's domain. This is where you sign in to manage your sites.
# Leave it empty to run locally: the admin opens at http://localhost:8080
ADMIN_DOMAIN=

# Address for Let's Encrypt: certificate expiry notices are sent here.
ACME_EMAIL=

# Which Caddyfile to use.
#   ./caddy/Caddyfile.local - plain HTTP, no certificates, for your own machine
#   ./caddy/Caddyfile       - HTTPS with automatic certificates, for a server
CADDYFILE=./caddy/Caddyfile.local

# Ports Caddy takes on the host.
# Locally: 8080/8443, listening only to this machine.
# On a server: 80/443, listening to the world (HTTP_BIND=0.0.0.0).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Postgres. Generate a password with: openssl rand -hex 24
POSTGRES_USER=yulia
POSTGRES_PASSWORD=yulia
POSTGRES_DB=yulia_production

# Postgres port on the host, for debugging only. Drop the published port in
# production if you do not need to connect from outside the compose network.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5433

# Signs cookies and encrypts stored TOTP secrets.
# Generate with: openssl rand -hex 64 - and keep it to yourself.
SECRET_KEY_BASE=

# How many days an admin session stays valid.
SESSION_DAYS=30

# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=64
